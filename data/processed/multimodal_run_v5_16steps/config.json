{
  "model": "ISLMultimodalModel",
  "rgb_dim": 768,
  "landmark_dim": 225,
  "fusion_dim": 512,
  "encoder_hidden": 256,
  "decoder_hidden": 512,
  "embedding_dim": 256,
  "attention_dim": 256,
  "dropout": 0.2,
  "word_dropout": 0.0,
  "use_embedding_in_output": false,
  "batch_size": 32,
  "lr": 0.0003,
  "min_lr": 1e-06,
  "lr_factor": 0.5,
  "lr_patience": 3,
  "early_stopping_patience": 9,
  "weight_decay": 0.0001,
  "grad_clip": 1.0,
  "seed": 42,
  "epochs": 100,
  "manifest": "data/metadata/dataset_splits.csv",
  "video_dir": "data/raw/videos",
  "rgb_feature_dir": "data/processed/videomae_features_32f",
  "landmark_dir": "data/processed/mediapipe_landmarks",
  "scheduler": "ReduceLROnPlateau",
  "scheduler_mode": "min",
  "vocab_size": 4024
}